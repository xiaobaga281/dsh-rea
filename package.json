{
  "name": "dsh-rea",
  "version": "1.8.5",
  "displayName": "逆向分析",
  "description": "Reverse-engineering tools for DeepSeek Harness: a deferred full-schema catalog, hardened path/trust boundaries, structured result index, trusted playbooks, local static triage with a measured decode ladder (repeating-key XOR, RC4, stack strings, API hashes), compressed-container and delta/interleave recovery, per-build watermark detection, an explicit honesty report for unopenable regions, evidence exports, environment sidebar, and redundant-mirror self-update.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "lib/*.mjs",
    "scripts/*.mjs",
    "scripts/duel/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/rea-runtime.tgz",
    "vendor/rea-runtime.sha256",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test",
    "pack": "npm pack --pack-destination dist",
    "manifest": "node scripts/update-manifest.mjs",
    "host-matrix": "node scripts/host-matrix.mjs",
    "concurrency": "node scripts/concurrency-probe.mjs",
    "make-sample": "node scripts/make-sample.mjs",
    "demo": "node scripts/capability-demo.mjs",
    "triage-baseline": "node scripts/triage-baseline.mjs",
    "ladder": "node scripts/harden-ladder.mjs",
    "duel": "node scripts/duel.mjs",
    "fetch-corpus": "node scripts/fetch-corpus.mjs",
    "corpus-scan": "node scripts/corpus-scan.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "cordis",
    "plugin",
    "reverse-engineering",
    "mcp",
    "ghidra"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobaga281/dsh-rea.git"
  },
  "homepage": "https://github.com/xiaobaga281/dsh-rea#readme",
  "bugs": {
    "url": "https://github.com/xiaobaga281/dsh-rea/issues"
  },
  "author": "xiaobaga281",
  "engines": {
    "node": ">=18.0.0"
  }
}
