{
  "name": "dsh-rea",
  "version": "1.5.0",
  "displayName": "逆向分析",
  "description": "Reverse-engineering tools for DeepSeek Harness: a deferred 207-tool catalog with full-schema progressive disclosure, hardened path/trust boundaries, structured result index, trusted playbooks, local static triage, evidence exports, environment sidebar, and redundant-mirror self-update.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "lib/*.mjs",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/rea-runtime.tgz",
    "vendor/rea-runtime.sha256"
  ],
  "scripts": {
    "test": "node --test",
    "pack": "npm pack --pack-destination dist",
    "manifest": "node scripts/update-manifest.mjs",
    "host-matrix": "node scripts/host-matrix.mjs",
    "concurrency": "node scripts/concurrency-probe.mjs",
    "triage-baseline": "node scripts/triage-baseline.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "cordis",
    "plugin",
    "reverse-engineering",
    "mcp",
    "ghidra"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaobaga281/dsh-rea.git"
  },
  "homepage": "https://github.com/xiaobaga281/dsh-rea#readme",
  "bugs": {
    "url": "https://github.com/xiaobaga281/dsh-rea/issues"
  },
  "author": "xiaobaga281",
  "engines": {
    "node": ">=18.0.0"
  }
}
