# Dependencies and build output never belong to the source tree
node_modules/
dist/

# Release artifacts are produced by `npm pack`; vendor/ is shipped on purpose
*.tgz
!vendor/rea-runtime.tgz
*.zip

# Local caches and logs
.npm-cache/
*.log

# Editor / OS noise
.DS_Store
Thumbs.db

# Agent workspace data (memory, local state)
.workbuddy/

# Local reverse-engineering engines (Ghidra, JDK) - never committed
.tools/

# REA Ghidra per-run scratch, created beside the target when TMP is unset
rea-ghidra-*/

# First-party Ghidra project files (analysis output, not source)
ghidra-work/
